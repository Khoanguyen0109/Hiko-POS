# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pos-db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CORS Configuration (for production)
# Add your frontend domain here
FRONTEND_URL=https://your-frontend-domain.com

# Zalo ZNS OTP (campaign spin phone verification)
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZNS_OTP_TEMPLATE_ID=619202
ZNS_OTP_PARAM_NAME=otp
# Set true to skip real ZNS sends (also auto-enabled when NODE_ENV=test)
ZNS_OTP_DRY_RUN=false
# Optional; falls back to JWT_SECRET
OTP_HASH_SECRET=
